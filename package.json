{
  "name": "@local/plugin-install-progress",
  "version": "1.1.0",
  "private": true,
  "description": "Shows a progress card while the agent installs a DSH plugin or downloads a large file.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Exceptions-del/dsh-plugin-install-progress.git"
  },
  "homepage": "https://github.com/Exceptions-del/dsh-plugin-install-progress#readme",
  "bugs": {
    "url": "https://github.com/Exceptions-del/dsh-plugin-install-progress/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/host-wrapper.test.mjs && node test/download-tool.test.mjs && node test/client-model.test.mjs",
    "check": "node --check client.js && node --check index.js"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
